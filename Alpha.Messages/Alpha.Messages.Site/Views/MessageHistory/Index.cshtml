@model MessagesHistoryViewModel

<div role="tabpanel" class="tab-pane active">

    @if (Model.MessageType != MessageType.Special)
    {
        <div class="filter">
            @using (Html.BeginForm("Messages", "MessageHistory", new { messageType = Model.MessageType }, FormMethod.Post, new { id = "report-form" }))
            {
                <div class="form-group">
                    <label class="txt">@Resources.from</label>
                    <div class="control date">
                        <div class="input-group date" id="fromDateContainer">
                            <input class="form-control" id="FromDate" name="FromDate" type="text" value=@Model.FromDate />
                            <span class="input-group-addon">
                                <span class="icon-calendar"></span>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="txt">@Resources.to</label>
                    <div class="control date">
                        <div class="input-group date" id="toDateContainer">
                            <input class="form-control" id="ToDate" name="ToDate" type="text" value=@Model.ToDate />
                            <span class="input-group-addon">
                                <span class="icon-calendar"></span>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group group-button">
                    <input type="submit" value="@Resources.submit" class="btn-submit" />
                </div>
            }
        </div>
    }

    <table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover">
        <thead>
            <tr>
                <th class="col-order">#</th>
                <th>@Resources.message</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Messages.Any())
            {
                <tr>
                    <td colspan="2" class="text-center">@Resources.NoInformationIsAvailable</td>
                </tr>
            }
            @foreach (var message in Model.Messages.Select((value, index) => new { index, value }))
            {
                <tr>
                    <td class="col-order">@(message.index + 1)</td>
                    <td>
                        <div class="row-first">
                            @message.value.PostTime
                            <span class="messageId">@message.value.Id</span>
                            @if (Model.IsNewMessage(message.value.PostTime))
                            {
                                <span class="badge-title">@Resources.New</span>
                            }
                        </div>
                        <div class="message-content @(message.value.HasRedColor ? "text-red" : string.Empty)">
                            @Html.Raw(message.value.Content(Model.LanguageKey))
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts{
    @StaticResources.RenderScripts("~/assets/bundles/message")
}