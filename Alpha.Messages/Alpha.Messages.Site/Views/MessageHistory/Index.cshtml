@using Alpha.Messages.Extensions
@model MessagesHistoryViewModel
@{
    Layout = Model.IsDevice ? "~/Views/Shared/_LayoutMobile.cshtml" : "~/Views/Shared/_Layout.cshtml";
}

<div role="tabpanel" class="tab-pane active">

    @if (Model.MessageType != MessageType.Special)
    {
        <div class="filter">
            @using (Html.BeginForm("Messages", "MessageHistory", new { messageType = Model.MessageType }, FormMethod.Post, new { id = "report-form", @class = "form-inline" }))
            {
                <div class="form-group from-date-box">
                    <label class="txt">@Resources.from</label>
                    <div class="control date">
                        <div class="input-group date" id="fromDateContainer">
                            <input type="text" 
                                   class="ui_nexdatepicker_datetextbox ui_nexdatepicker_fromdate form-control" 
                                   id="FromDate" 
                                   name="FromDate" 
                                   readonly="readonly" 
                                   autocomplete="off" 
                                   value=@Model.FromDate.ToShortFormatDate() />
                            <span class="input-group-addon">
                                <span class="icon-calendar" id="fdate_trigger"></span>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group to-date-box">
                    <label class="txt">@Resources.to</label>
                    <div class="control date">
                        <div class="input-group date" id="toDateContainer">
                            <input type="text"
                                   class="ui_nexdatepicker_datetextbox ui_nexdatepicker_fromdate form-control" 
                                   id="ToDate" 
                                   name="ToDate"                                     
                                   readonly="readonly" 
                                   autocomplete="off" 
                                   value=@Model.ToDate.ToShortFormatDate() />
                            <span class="input-group-addon">
                                <span class="icon-calendar" id="tdate_trigger"></span>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group group-button">
                    <input type="submit" value="@Resources.submit" class="btn-submit" />
                </div>
            }
        </div>
    }

    <table class="tblRpt tbl-style2">
        <thead>
            <tr>
                <th class="col-order">#</th>
                <th>@Resources.message</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Messages.Any())
            {
                <tr>
                    <td colspan="2" class="text-center">@Resources.NoInformationIsAvailable</td>
                </tr>
            }
            @foreach (var message in Model.Messages.Select((value, index) => new { index, value }))
            {
                <tr>
                    <td class="col-order">@(message.index + 1)</td>
                    <td>
                        <div class="row-first">
                            @message.value.PostTime.ToString("yyyy-MM-dd HH:mm:ss")
                            <span class="messageId">@message.value.Id</span>
                            @if (Model.IsNewMessage(message.value.PostTime))
                            {
                                <span class="badge-title">@Resources.New</span>
                            }
                        </div>
                        <div class="message-content @(message.value.HasRedColor ? "text-red" : string.Empty)">
                            @Html.Raw(message.value.Content(Model.LanguageKey))
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts{
    @StaticResources.RenderScripts("~/assets/bundles/message")
}