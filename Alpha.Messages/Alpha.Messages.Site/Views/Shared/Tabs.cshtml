<li role="presentation" class="@(Model.MessageType == MessageType.Normal ? "active" : string.Empty)">
    <a href="@Url.Action("Index", "MessageHistory", new { messageType = MessageType.Normal })">
        <span class="hidden-mobile">
            @Resources.normalAnnouncement
        </span>
        <span class="visible-mobile">
            @Resources.normal
        </span>
        @if (Model.UnreadMessage.Normal > 0)
        {
            <span class="badge-title">@Model.UnreadMessage.Normal</span>
        }
    </a>
</li>
