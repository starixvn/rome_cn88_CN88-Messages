@using Alpha.Messages.Extensions

@model PortalMessagesViewModel

<div class="message-content">
    @if (!Model.NormalMessages.Any() && !Model.HighlightMessages.Any())
    {
        <div class="text-center" id="no-info">@Resources.NoInformationIsAvailable</div>
    }
    else
    {
        if (Model.HighlightMessages.Any())
        {
            <div class="group-date">@Resources.highlights</div>
            foreach (var message in Model.HighlightMessages)
            {
                <div class="msg-contents">
                    <div id="@message.CurrentMessage.Id"
                         class="message pointer @message.MessageType @(!message.CurrentMessage.IsRead ? "bold" : string.Empty)">
                        <div class="time">
                            <span class="icon icon-plus"></span>
                            @message.PostTime.ToShortFormatDate()
                            <div class="highlight-date-format">@message.PostTime.ToLongTime24h()</div>
                        </div>
                        <div class="content short-content @message.GetStyleMessage">
                            @message.ShortContent
                        </div>
                        <div class="content full-content @message.GetStyleMessage">
                            @message.Content
                        </div>
                    </div>
                </div>
            }
        }

        var tempPostTime = DateTime.MinValue;
        foreach (var message in Model.NormalMessages)
        {
            var currentPostTime = message.PostTime;

            if (currentPostTime.Date != tempPostTime.Date)
            {
                <div class="group-date">@currentPostTime.ToShortFormatDate()</div>
                tempPostTime = currentPostTime;
            }

            <div class="msg-contents">
                <div id="@message.CurrentMessage.Id"
                     class="message pointer @message.MessageType @(!message.CurrentMessage.IsRead ? "bold" : string.Empty)">
                    <div class="time">
                        <span class="icon icon-plus"></span>
                        @message.PostTime.ToLongTime24h()
                    </div>
                    <div class="content short-content @message.GetStyleMessage">
                        @message.ShortContent
                    </div>
                    <div class="content full-content @message.GetStyleMessage">
                        @message.Content
                    </div>
                </div>
            </div>
        }
    }
</div>

<span id="view-announcements" class="view-more" data-target="@PortalMessagesViewModel.AnnouncementsPath">@Resources.ViewMore</span>