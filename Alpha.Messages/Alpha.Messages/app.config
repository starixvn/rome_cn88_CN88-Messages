<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
        
    <section name="Fanex.Caching" type="Fanex.Caching.Configuration.CacheSettings, Fanex.Caching" /><section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" /></configSections>
  
<Fanex.Caching cacheType="Fanex.Caching.Memory.MemoryCache, Fanex.Caching">
        <connectionSettings>
            <add name="CompactOnMemoryPressure" value="true" />
            <add name="ExpirationScanFrequency" value="1" />
        </connectionSettings>
    </Fanex.Caching><Fanex.Logging msmqPath="FormatName:DIRECT=tcp:[IP]\private$\entlib" defaultCategory="$CategoryValue" filePath="$FilePath" /></configuration>